HF_TOKEN=your-huggingface-token
OPENROUTER_TOKEN=your-openrouter-token

# Models used by ragbench_lib.models (embedding / generator / judge LLMs).
# Notebooks that deliberately test a different model as their experiment
# variable (e.g. 03_chunking_optimization.ipynb, 06's query_llm) pass an
# explicit model= override and are unaffected by these.
RAGBENCH_EMBEDDING_MODEL=openai/text-embedding-3-small
RAGBENCH_GENERATOR_MODEL=meta-llama/llama-3.1-8b-instruct
RAGBENCH_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct
